# .env.example — 環境變數範例
# 複製此檔案為 .env 並填入實際 API Key，或透過 CI/CD 平台直接注入

# 子公司 Cloudability API Key（需具備 Read 權限）
SUBSIDIARY_A_API_KEY=your_subsidiary_a_api_key_here
SUBSIDIARY_B_API_KEY=your_subsidiary_b_api_key_here
SUBSIDIARY_C_API_KEY=your_subsidiary_c_api_key_here
SUBSIDIARY_D_API_KEY=your_subsidiary_d_api_key_here
SUBSIDIARY_E_API_KEY=your_subsidiary_e_api_key_here
SUBSIDIARY_F_API_KEY=your_subsidiary_f_api_key_here
SUBSIDIARY_G_API_KEY=your_subsidiary_g_api_key_here

# FCoE Cloudability API Key（需具備 Read/Write 權限）
FCOE_API_KEY=your_fcoe_api_key_here

# 選填：覆蓋設定檔路徑（預設 ./config.yaml）
# CONFIG_PATH=/etc/datasync/config.yaml

# 選填：覆蓋 Cloudability Base URL
# CLOUDABILITY_BASE_URL=https://api.cloudability.com/v3

# 選填：HTTP 服務設定
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080

# 選填：Log 等級（DEBUG / INFO / WARNING / ERROR）
# LOG_LEVEL=INFO
